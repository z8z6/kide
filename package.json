{
  "name": "kelyra",
  "displayName": "Kelyra",
  "description": "Kelyra language and Kelp project support",
  "version": "0.6.0",
  "publisher": "z8z6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/z8z6/kide.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:kelyra",
    "onLanguage:kelp",
    "onView:kelp.actions"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Kelp runs workspace-configured compiler and debugger executables."
    }
  },
  "scripts": {
    "test": "node --check extension.js && node test/smoke.js && node test/debug.js && node test/activate.js"
  },
  "contributes": {
    "breakpoints": [{ "language": "kelyra" }],
    "languages": [
      {
        "id": "kelyra",
        "aliases": [
          "Kelyra",
          "kelyra"
        ],
        "extensions": [
          ".kly"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "kelp",
        "aliases": [
          "Kelp"
        ],
        "filenames": [
          "kelp.toml"
        ],
        "configuration": "./kelp-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kelyra",
        "scopeName": "source.kelyra",
        "path": "./syntaxes/kelyra.tmLanguage.json"
      },
      {
        "language": "kelp",
        "scopeName": "source.kelp.toml",
        "path": "./syntaxes/kelp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kelyra",
        "path": "./snippets/kelyra.json"
      },
      {
        "language": "kelp",
        "path": "./snippets/kelp.json"
      }
    ],
    "configurationDefaults": {
      "[kelyra]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[kelp]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "themes": [
      {
        "label": "Kelyra Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kelyra-dark-color-theme.json"
      },
      {
        "label": "Kelyra Light",
        "uiTheme": "vs",
        "path": "./themes/kelyra-light-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "kelp.format",
        "title": "Kelp: Format File",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "kelp.check",
        "title": "Kelp: Check",
        "icon": "$(check)"
      },
      {
        "command": "kelp.build",
        "title": "Kelp: Compile",
        "icon": "$(tools)"
      },
      {
        "command": "kelp.debug",
        "title": "Kelp: Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "kelp.run",
        "title": "Kelp: Run",
        "icon": "$(play)"
      },
      {
        "command": "kelp.test",
        "title": "Kelp: Test",
        "icon": "$(beaker)"
      },
      {
        "command": "kelp.package",
        "title": "Kelp: Package",
        "icon": "$(package)"
      },
      {
        "command": "kelp.members",
        "title": "Kelp: Members",
        "icon": "$(list-unordered)"
      }
    ],
    "problemMatchers": [
      {
        "name": "kelyra",
        "owner": "kelyra",
        "source": "kelyra",
        "fileLocation": "auto",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): error: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kelp",
          "title": "Kelp",
          "icon": "assets/kelp.svg"
        }
      ]
    },
    "views": {
      "kelp": [
        {
          "id": "kelp.actions",
          "name": "Project Actions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kelp.format",
          "when": "view == kelp.actions",
          "group": "navigation@0"
        },
        {
          "command": "kelp.build",
          "when": "view == kelp.actions",
          "group": "navigation@1"
        },
        {
          "command": "kelp.debug",
          "when": "view == kelp.actions",
          "group": "navigation@2"
        },
        {
          "command": "kelp.run",
          "when": "view == kelp.actions",
          "group": "navigation@3"
        },
        {
          "command": "kelp.test",
          "when": "view == kelp.actions",
          "group": "navigation@4"
        },
        {
          "command": "kelp.package",
          "when": "view == kelp.actions",
          "group": "navigation@5"
        },
        {
          "command": "kelp.members",
          "when": "view == kelp.actions",
          "group": "navigation@6"
        }
      ],
      "editor/title": [
        {
          "command": "kelp.format",
          "when": "editorLangId == kelyra",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Kelyra",
      "properties": {
        "kelyra.formatter.path": {
          "type": "string",
          "default": "kelyra-format",
          "description": "Path to the kelyra-format executable."
        },
        "kelyra.languageServer.path": {
          "type": "string",
          "default": "kelyra-ls",
          "description": "Path to the kelyra-ls executable."
        },
        "kelp.path": {
          "type": "string",
          "default": "kelp",
          "description": "Path to the kelp executable."
        },
        "kelp.debug.gdbPath": {
          "type": "string",
          "default": "gdb",
          "description": "Local GDB executable (from PATH or an absolute path). Requires the Microsoft C/C++ debug adapter."
        },
        "kelp.debug.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments passed to the program by Kelp: Debug."
        },
        "kelyra.inlayHints.parameterNames": {
          "type": "string",
          "enum": [
            "off",
            "literals",
            "all"
          ],
          "default": "literals",
          "markdownDescription": "Show parameter name inlay hints at call sites: `off`, `literals` (only literal arguments), or `all`. Workspace modules are indexed to resolve signatures."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  }
}
